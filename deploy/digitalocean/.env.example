SANDBOX_VERSION=0.7.10-beta.2
SANDBOX_DOMAIN=sndbox.app
SANDBOX_APP_DOMAIN=app.sndbox.app
SANDBOX_HTTP_BIND=127.0.0.1
SANDBOX_RELEASE_MANIFEST_URL=https://github.com/sndboxhq/sandbox/releases/download/v0.7.10-beta.2/release-manifest.json

# Account portal. Use a dedicated Auth0 Regular Web Application.
CONTROL_PLANE_URL=https://api.sndbox.app
OIDC_AUTHORIZE_URL=https://YOUR_AUTH0_DOMAIN/authorize
OIDC_TOKEN_URL=https://YOUR_AUTH0_DOMAIN/oauth/token
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.sndbox.app/auth/callback
OIDC_AUDIENCE=https://api.sndbox.app

# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to keep instrumentation disabled.
# Set it to the internal Alloy endpoint when enabling the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Grafana Cloud > Home > Setup guide > OpenTelemetry > Production.
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# A stable, unique identifier for this Docker host. It is not a secret.
GRAFANA_HOST_ID=sandbox-marketing-do-01
SANDBOX_ALLOY_HTTP_BIND=127.0.0.1
